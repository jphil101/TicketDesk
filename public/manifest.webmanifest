{
  "name": "Ticket Desk",
  "short_name": "Tickets",
  "description": "Low-friction personal ticketing with automatic priority, recurring tasks and sync across devices.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e9ecf2",
  "theme_color": "#161a2b",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "New ticket",
      "short_name": "New ticket",
      "url": "/?focus=new",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
